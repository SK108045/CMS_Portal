<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.22">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    Local development should be one command.
    In Debug builds (including `dotnet run`), build the React/Vite frontend and
    copy the generated assets into ASP.NET's wwwroot before the server starts.
    Production publishing still uses scripts/build.mjs, so Release publish is
    not forced to rebuild the frontend twice.
  -->
  <Target
    Name="BuildFrontendForLocalRun"
    BeforeTargets="Build"
    Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
    <Message Text="Building React frontend for local ASP.NET run..." Importance="high" />

    <Exec
      Command="npm ci"
      WorkingDirectory="$(MSBuildProjectDirectory)/../frontend"
      Condition="!Exists('$(MSBuildProjectDirectory)/../frontend/node_modules')" />

    <Exec
      Command="npm run build"
      WorkingDirectory="$(MSBuildProjectDirectory)/../frontend" />

    <RemoveDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />

    <ItemGroup>
      <FrontendDist Include="$(MSBuildProjectDirectory)/../frontend/dist/**/*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(FrontendDist)"
      DestinationFiles="@(FrontendDist->'$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
